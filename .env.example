# Supabase public client configuration
# Never put a Supabase secret/service-role key in the browser app.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Optional: set a fixed workspace UUID. If omitted, MADHAQ creates/selects the first workspace for the signed-in user.
# VITE_MADHAQ_WORKSPACE_ID=YOUR_WORKSPACE_UUID
